event_log$timestamp,
units = "mins"
)
# -------------------------------------------------
# 6. Manchester Priority Mapping
# -------------------------------------------------
if ("priority" %in% names(event_log)) {
event_log$priority_char <- trimws(
as.character(event_log$priority)
)
event_log$priority_label <- unname(
priority_mapping[event_log$priority_char]
)
# Fallback for unexpected or missing values
event_log$priority_label[
is.na(event_log$priority_label)
] <- "White"
} else {
event_log$priority_label <- "White"
}
# Preserve clinical priority ordering
event_log$priority_label <- factor(
event_log$priority_label,
levels = names(priority_colors),
ordered = TRUE
)
# -------------------------------------------------
# 7. Create Event Log
# -------------------------------------------------
ex1_log <- eventlog(
event_log,
case_id              = "case_id",
activity_id          = "activity",
activity_instance_id = "activity_instance_id",
lifecycle_id         = "lifecycle",
timestamp            = "timestamp",
resource_id          = "resource"
)
# -------------------------------------------------
# Reduce size: keep only the last N cases
# -------------------------------------------------
library(dplyr)   # if not already loaded
# Option A – last 150–250 cases (usually gives ~0.8–1.5 MB)
# Adjust the number until the HTML is around 1 MB
n_cases_to_keep <- 2000
last_cases <- ex1_log %>%
cases() %>%                 # get case overview
arrange(desc(start_timestamp)) %>%   # most recent first
slice_head(n = n_cases_to_keep) %>%
pull(case_id)
ex1_log_small <- ex1_log %>%
filter_case(cases = last_cases)
# Option B – simple percentage (easier to tune)
# ex1_log_small <- sample_n(ex1_log, size = 0.08)   # ~8 % of cases
# -------------------------------------------------
# 8. Animation
# -------------------------------------------------
time_range <- attr(ex1_log, "time_range")
start_time <- time_range[1]
end_time   <- time_range[2]
final_animation <- animate_process(
# ex1_log,
ex1_log_small,          # ← use the reduced log
mode       = "absolute",
duration   = 120,
start_time = start_time,
end_time   = end_time,
mapping = token_aes(
color = token_scale(
"priority_label",
scale = "ordinal",
domain = names(priority_colors),   # ← critical
range = unname(priority_colors)
)
),
legend   = "color",
timeline = TRUE
)
print(final_animation)
# -------------------------------------------------
# 9. Save Animation
# -------------------------------------------------
htmlwidgets::saveWidget(
final_animation,
"hrtn.html",
selfcontained = TRUE
)
cat("Manchester priority colors:\n")
print(priority_colors)
